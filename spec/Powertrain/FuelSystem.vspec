#
# Fuel system for ICE / hybrids
# This file contains basic information
# If detailed consumption/economy figures are needed use
# VolumeFuelSystem or MassFuelSystem instead

#
# The fuels system signals and attributes used to host the signals in FuelSystem.vspec.
#

Range:
  datatype: uint32
  type: sensor
  unit: m
  description: Remaining range in meters using fuel in this fuelsystem.

TimeRemaining:
  datatype: uint32
  type: sensor
  unit: s
  description: Time remaining in seconds before the fuel system is out of fuel.
