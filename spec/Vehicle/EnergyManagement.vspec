# Intended for energy management during a trip
#
# Please see energy_management.md in documentation for more information

EnergyManagement:
  type: branch
  description: Energy Management Information.

EnergyManagement.IsEnabled:
  datatype: boolean
  type: actuator
  description: This flag will be used to enable the execution of predictive energy optimization functions.
  comment: The feature can only be enabled if a destination has been set by Vehicle.Cabin.Infotainment.Navigation.

EnergyManagement.IsRecalculationRequest:
  datatype: boolean
  type: actuator
  description: This flag is used to request recalculation. The request shall be reset when a new prediction has been received.

EnergyManagement.ConditioningArraySize:
  datatype: uint16
  type: sensor
  default: 100
  description: Number of elements used in arrays related to controlling battery conditioning.

EnergyManagement.ConditioningTimestamp:
  datatype: uint32[]
  type: sensor
  unit: s
  description: Time vector for battery conditioning in the vehicle.
               Time is relative to activation of feature or trip.
               Number of elements expected to correspond with EnergyManagement.ConditioningArraySize.


EnergyManagement.ConditioningBatteryTemperature:
  datatype: float[]
  type: sensor
  unit: Celsius
  description: Desired average battery temperature at timestamps indicated by EnergyManagement.ConditioningTimestamp.
               Number of elements expected to correspond with EnergyManagement.ConditioningArraySize.

EnergyManagement.ConditioningHeaterPower:
  datatype: float[]
  type: sensor
  unit: W
  description: Desired heating power for the battery conditioning coolant at timestamps indicated by EnergyManagement.ConditioningTimestamp.
               Number of elements expected to correspond with EnergyManagement.ConditioningArraySize.

EnergyManagement.ConditioiningCoolantMassFlow:
  datatype: float[]
  type: sensor
  unit: kg/s
  description: Desired coolant mass flow through battery at timestamps indicated by EnergyManagement.ConditioningTimestamp.
               Number of elements expected to correspond with EnergyManagement.ConditioningArraySize.

EnergyManagement.CheckArraySize:
  datatype: uint16
  type: sensor
  default: 20
  description: Number of elements used in arrays related to checking status of the battery management feature.

EnergyManagement.CheckTimestamp:
  datatype: uint32[]
  type: sensor
  unit: s
  description: Time vector for checking status of energy management feature.
               Time is relative to activation of feature or trip.
               Number of elements expected to correspond with EnergyManagement.CheckArraySize.

EnergyManagement.CheckLatitude:
  datatype: double[]
  type: sensor
  min: -90
  max: 90
  unit: degrees
  description: Expected latitude in WGS 84 geodetic coordinates at corresponding timestamp in EnergyManagement.CheckTimestamp.
               Number of elements expected to correspond with EnergyManagement.CheckrraySize.

EnergyManagement.CheckLongitude:
  datatype: double[]
  type: sensor
  min: -180
  max: 180
  unit: degrees
  description: Expected longitude in WGS 84 geodetic coordinates at corresponding timestamp in EnergyManagement.CheckTimestamp.
               Number of elements expected to correspond with EnergyManagement.CheckArraySize.
