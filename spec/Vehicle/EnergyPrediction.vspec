# Intended for follow up on prediction on energy usage for a trip
#
# Please see energy_prediction.md in documentation for more information

EnergyPrediction:
  type: branch
  description: Motion Management Information.

EnergyPrediction.IsEnabled:
  datatype: boolean
  type: actuator
  description: This flag will be used to enable the execution of predictive energy optimization functions.
  comment: The feature can only be enabled if a destination has been set by Vehicle.Cabin.Infotainment.Navigation.

EnergyPrediction.IsRecalculationRequest:
  datatype: boolean
  type: actuator
  description: This flag is used to request recalculation. The request shall be reset when a new prediction has been received.

EnergyPrediction.PredictionArraySize:
  datatype: uint16
  type: sensor
  default: 100
  description: Expected number of elements in planned arrays.

EnergyPrediction.PlannedTimestamp:
  datatype: uint32[]
  type: sensor
  unit: unix-time
  description: Time (unix timestamps) for timestamps to check if on track.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.PlannedTimestampRelative:
  datatype: uint32[]
  type: sensor
  unit: s
  description: Time vector for control of vehicle.
               Corresponds to EnergyPrediction.PlannedTimestamp but timestamps are
               relative to feature activation.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.PlannedLatitude:
  datatype: double[]
  type: sensor
  min: -90
  max: 90
  unit: degrees
  description: Expected latitude in WGS 84 geodetic coordinates at corresponding planned timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.PlannedLongitude:
  datatype: double[]
  type: sensor
  min: -180
  max: 180
  unit: degrees
  description: Expected longitude in WGS 84 geodetic coordinates at corresponding planned timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.PlannedBatteryTemperature:
  datatype: float[]
  type: sensor
  unit: Celsius
  description: Desired average battery temperature at corresponding planned timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.PlannedHeaterPower:
  datatype: float[]
  type: sensor
  unit: W
  description: Desired Hhating power of coolant for the battery conditioning at corresponding planned timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.PlannedCoolantMassFlow:
  datatype: float[]
  type: sensor
  unit: kg/s
  description: Desired coolant mass flow through battery
               at corresponding planned timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.
