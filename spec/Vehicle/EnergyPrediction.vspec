# Intended for follow up on prediction on energy usage for a trip
#
# Please see energy_prediction.md in documentation for more information

EnergyPrediction:
  type: branch
  description: Motion Management Information.

EnergyPrediction.IsEnabled:
  datatype: boolean
  type: actuator
  description: This flag will be used to enable the execution of predictive energy optimization functions.
  comment: The feature can only be enabled if a destination has been set by Vehicle.Cabin.Infotainment.Navigation.

EnergyPrediction.IsRecalculationRequest:
  datatype: boolean
  type: actuator
  description: This flag is used to request recalculation. Shall be reset when recalculation is finished.

EnergyPrediction.PredictionArraySize:
  datatype: uint16
  type: sensor
  default: 100
  description: Expected number of elements in trajectory arrays.

EnergyPrediction.TrajectoryTimestamp:
  datatype: uint32[]
  type: sensor
  unit: unix-time
  description: Time (unix timestamps) for desired vehicle trajectory to check if on track.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.TrajectoryTimestampRelative:
  datatype: uint32[]
  type: sensor
  unit: s
  description: Time vector for control of vehicle.
               Corresponds to EnergyPrediction.TrajectoryTimestamp but timestamps are
               relative to feature activation.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.TrajectoryLatitude:
  datatype: double[]
  type: sensor
  min: -90
  max: 90
  unit: degrees
  description: Expected latitude in WGS 84 geodetic coordinates at corresponding trajectory timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.TrajectoryLongitude:
  datatype: double[]
  type: sensor
  min: -180
  max: 180
  unit: degrees
  description: Expected longitude in WGS 84 geodetic coordinates at corresponding trajectory timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.TrajectoryBatteryTemperature:
  datatype: float[]
  type: sensor
  unit: Celsius
  description: Desired average battery termperature at corresponding trajectory timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.TrajectoryPTCHeaterPower:
  datatype: float[]
  type: sensor
  unit: W
  description: Desired power usage of the PTC heater at corresponding trajectory timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.

EnergyPrediction.TrajectoryCoolantMassFlow:
  datatype: float[]
  type: sensor
  unit: kg/s
  description: Desired coolant mass flow for the low termperature circuit
               at corresponding trajectory timestamp.
               Number of elements expected to correspond with EnergyPrediction.PredictionArraySize.
